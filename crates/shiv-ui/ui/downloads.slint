// Activity: active transfers and persistent history of Shiv's actions.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextButton, ProgressBar } from "widgets.slint";
import { CenteredMessage } from "browse.slint";

export enum DownloadPhase { downloading, installing, done, failed, cancelled }

export struct TransferRow {
    id: string,
    name: string,
    phase: DownloadPhase,
    // 0..1, negative when the size is unknown.
    progress: float,
    // "12.3 MB of 52.0 MB · 4.2 MB/s", "Installing", or a recorded action summary.
    detail: string,
    // Short action tag ("Installed", "Updated", "Replaced", "Settings", ...).
    kind-label: string,
    // Relative timestamp ("Just now", "5m ago"); "" while active.
    when: string,
    // True when Retry triggers an actual retryable transfer.
    retryable: bool,
}

export global DownloadsState {
    in property <[TransferRow]> rows;
    in property <int> active-count: 0;
    callback cancel(string);
    callback retry(string);
    callback clear-finished();
}

component DownloadRowView inherits Rectangle {
    in property <TransferRow> item;
    height: 58px + 2 * Theme.s1 + 1px;

    HorizontalLayout {
        padding: Theme.s1;
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        VerticalLayout {
            alignment: center;
            spacing: Theme.s1;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Theme.s1;
                alignment: start;
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-size: Theme.text-lg;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.kind-label != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: kind-text.preferred-width + 12px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: root.item.phase == DownloadPhase.failed ? Theme.danger.with-alpha(0.5) : Theme.border-strong;
                        background: Theme.raised;
                        kind-text := Text {
                            text: root.item.kind-label;
                            color: root.item.phase == DownloadPhase.failed ? Theme.danger : Theme.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.item.when != "": Text {
                    text: root.item.when;
                    color: Theme.text-faint;
                    font-size: Theme.text-sm;
                    vertical-alignment: center;
                }
            }
            if root.item.phase == DownloadPhase.downloading: ProgressBar {
                progress: root.item.progress;
            }
            Text {
                text: root.item.detail;
                color: root.item.phase == DownloadPhase.failed ? Theme.danger : Theme.text-muted;
                font-size: Theme.text-md;
                overflow: elide;
            }
        }

        HorizontalLayout {
            width: 96px;
            alignment: end;
            if root.item.phase == DownloadPhase.downloading: TextButton {
                text: "Cancel";
                clicked => { DownloadsState.cancel(root.item.id); }
            }
            if (root.item.phase == DownloadPhase.failed || root.item.phase == DownloadPhase.cancelled) && root.item.retryable: Button {
                text: "Retry";
                clicked => { DownloadsState.retry(root.item.id); }
            }
        }
    }

    Rectangle {
        x: Theme.s1;
        y: parent.height - 1px;
        width: parent.width - Theme.s1;
        height: 1px;
        background: Theme.border;
    }
}

export component DownloadsPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding: Theme.s3;
        padding-bottom: 0px;
        spacing: Theme.s2;

        HorizontalLayout {
            spacing: Theme.s2;
            Text {
                text: "Activity";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                horizontal-stretch: 1;
            }
            TextButton {
                text: "Clear history";
                clicked => { DownloadsState.clear-finished(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if DownloadsState.rows.length == 0: CenteredMessage {
                title: "No activity yet";
                detail: "Installs, updates, replacements and repairs show up here.";
            }

            ListView {
                for row in DownloadsState.rows: DownloadRowView {
                    item: row;
                }
            }
        }
    }
}
