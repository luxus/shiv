// Performance: stage a preset, the CompLock set or single settings from
// the API's perf catalog, review the pending changes, then write them to
// gameinfo.gi.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextButton, SearchField, Dropdown, Slider, Switch, Tooltip } from "widgets.slint";
import { LoadState, CenteredMessage } from "browse.slint";

// One of the five preset buttons.
export struct PerfTier {
    label: string,
    // The catalog preset behind it, e.g. "DMM Clean by ..."; "" when the catalog has none.
    name: string,
    blurb: string,
    available: bool,
}

// The CompLock card below the tiers.
export struct PerfComplock {
    title: string,
    // "deadlockconfig.com · build 6860 · fetched 2026-11-21 · N settings".
    subtitle: string,
    // The compatibility note from their site.
    note: string,
    available: bool,
}

// What one row in the CompLock options list is.
export enum PerfPackKind { heading, option, hud, fov }

// One row of the CompLock options list: a group heading, an option, the
// HUD++ base (its damage-number choices and pak) or the FOV slider.
export struct PerfPackRow {
    kind: PerfPackKind,
    // The option's id ("soundcap", "hud", "fov"); "" for headings.
    id: string,
    title: string,
    // The group's blurb for a heading, the convar and default for FOV.
    detail: string,
    // One line of the option's description.
    text: string,
    // The option's warning, in the danger colour.
    warn: string,
    // The option stages convars: a switch.
    has-toggle: bool,
    checked: bool,
    // The option (or the HUD base) installs a pak.
    has-pak: bool,
    installed: bool,
    // Installed and the revision the site publishes now (for the picked
    // choice): nothing to update, Reinstall forces it.
    current: bool,
    // "Install · 7.5 MB", "Update", "Installed" or "Downloading 42%".
    install-label: string,
    // A download is in flight for this row's pak.
    installing: bool,
    // The choice titles, when the option has versions.
    choices: [string],
    choice-index: int,
    // Measured gains, "+9.7%"; "" when the site gives none.
    avg: string,
    low: string,
    // The FOV slider's value and range.
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    value-text: string,
}

// One setting in the searchable list.
export struct PerfRow {
    name: string,
    // Label or help text, one line.
    detail: string,
    // Value in gameinfo.gi; "" when the file does not set it.
    current: string,
    // Staged value ("off" when it will be commented out); "" when unchanged.
    pending: string,
    selected: bool,
}

// How the selected setting is edited.
export enum PerfControl { toggle, slider, choice, text, locked }

// The selected setting.
export struct PerfEditor {
    open: bool,
    name: string,
    // "Lighting · float", plus a status note such as "blocked by the game".
    meta: string,
    help: string,
    // "Range 0 to 1000 · default 400"; "" when unknown.
    limits: string,
    // "In gameinfo.gi: 400" or "Not set in gameinfo.gi".
    current: string,
    control: PerfControl,
    // The value the control shows (pending, else current, else default).
    value: string,
    checked: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    options: [string],
    option-index: int,
    has-pending: bool,
    // Set in the file (so it can be commented out).
    is-set: bool,
    // Why the setting can't be edited, or why the last value was refused.
    note: string,
}

// One pending change.
export struct PerfChange {
    name: string,
    before: string,
    after: string,
}

export global PerfState {
    // Left column of the page: 0 the CompLock options, 1 every setting.
    in-out property <int> section: 0;
    in property <LoadState> load-state: LoadState.loading;
    in property <string> error-text;
    // Line under the title: catalog revision and the file's state.
    in property <string> status;
    in property <[PerfTier]> tiers;
    // Index of the staged preset; -1 for none.
    in property <int> active-tier: -1;
    in property <PerfComplock> complock;
    // The CompLock set is what is staged (the tiers are not).
    in property <bool> complock-staged: false;
    in property <[PerfPackRow]> pack-rows;
    in property <[PerfRow]> rows;
    in property <string> list-note;
    in property <PerfEditor> editor;
    in property <[PerfChange]> changes;
    in property <string> apply-label;
    in property <bool> game-running;
    // Writing gameinfo.gi on a worker thread.
    in property <bool> busy;
    // Outcome of the last apply; "" when none.
    in property <string> result-title;
    in property <string> result-detail;
    in property <bool> result-error;

    // The screen was shown, or left.
    callback shown();
    callback hidden();
    callback retry();
    callback search(string);
    callback select(int);
    callback pick-tier(int);
    callback stage-complock();
    callback toggle-pack(string);
    callback pick-pack-choice(string, int);
    callback install-pack(string);
    callback set-fov(float);
    callback set-text(string);
    callback set-number(float);
    callback toggle();
    callback pick-option(int);
    callback comment-out();
    callback revert();
    callback remove-change(int);
    callback discard();
    callback apply();
    callback dismiss-result();
}


// A preset in the one-line preset strip.
component PresetChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> available: true;
    // Hover text; "" for none.
    in property <string> tip;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label + " preset";
    accessible-action-default => {
        if (root.available) {
            root.clicked();
        }
    }

    height: Theme.control-h;
    min-width: t.preferred-width + 2 * Theme.s2;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.accent : (ta.has-hover && root.available ? Theme.border-strong : Theme.border);
    background: root.active ? Theme.accent.with-alpha(0.12) : (ta.has-hover && root.available ? Theme.hover : transparent);
    opacity: root.available ? 1.0 : 0.4;

    t := Text {
        text: root.label;
        color: root.active ? Theme.accent : Theme.text;
        font-size: Theme.text-md;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover) {
                Tooltip.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                Tooltip.hide(root.tip);
            }
        }
    }
}

// One choice of an option with versions (HUD++ damage numbers, particle sets).
component ChoiceChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    height: 28px;
    min-width: t.preferred-width + 2 * 12px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border);
    background: root.active ? Theme.accent.with-alpha(0.12) : transparent;

    t := Text {
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.text-sm;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Tab in the page's section switch: text with an accent underline.
component SectionTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    height: 36px;
    min-width: t.preferred-width;

    t := Text {
        y: 0px;
        height: parent.height - 2px;
        text: root.label;
        color: root.active ? Theme.text : (ta.has-hover ? Theme.text : Theme.text-muted);
        font-size: Theme.text-md;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.accent;
        visible: root.active;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Group heading: small caps title with its blurb on the same line.
component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> blurb;
    spacing: Theme.s1 + 4px;
    alignment: start;
    padding-bottom: 2px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        vertical-alignment: center;
    }
    Text {
        text: root.blurb;
        color: Theme.text-muted;
        font-size: Theme.text-sm;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The lead mark of a pak-only option: a ring, filled with a check when the
// pak is installed.
component InstalledMark inherits Rectangle {
    in property <bool> installed;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: root.installed ? 0px : 1.5px;
    border-color: Theme.border-strong;
    background: root.installed ? Theme.success : transparent;
    if root.installed: Path {
        width: 12px;
        height: 12px;
        x: 4px;
        y: 4px;
        commands: "M 2 6.5 L 5 9.5 L 10 3";
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: Theme.on-accent;
        stroke-width: 2px;
        fill: transparent;
    }
}

// The lead mark of the FOV card: a view cone, so its lead slot is not empty.
component FovMark inherits Path {
    width: 20px;
    height: 20px;
    viewbox-width: 20;
    viewbox-height: 20;
    commands: "M 10 17 L 2.5 5 M 10 17 L 17.5 5 M 4.2 7.6 A 11 11 0 0 1 15.8 7.6";
    stroke: Theme.text-muted;
    stroke-width: 1.5px;
    fill: transparent;
}

// One CompLock option as its own card: lead control, name and one line,
// the measured gains, the pak's state, and its choices or the FOV slider
// inside the card.
component PackCard inherits Rectangle {
    in property <PerfPackRow> item;
    callback toggled;
    callback picked(int);
    callback installed;
    callback fov-changed(float);

    accessible-role: list-item;
    accessible-label: root.item.title;

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : Theme.border;
    background: Theme.raised;

    height: layout.preferred-height;

    // The card's content sits inside its hover area, so pointing at a
    // control in the card keeps the card hovered (Reinstall stays).
    ta := TouchArea {
        layout := VerticalLayout {
            padding: Theme.s2;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 12px;

            HorizontalLayout {
                spacing: Theme.s2;

                // Lead: the option's switch, else the pak's installed mark, else the FOV mark.
                VerticalLayout {
                    width: 40px;
                    alignment: center;
                    if root.item.has-toggle: Switch {
                        label: root.item.title;
                        checked: root.item.checked;
                        toggled => { root.toggled(); }
                    }
                    if !root.item.has-toggle && root.item.has-pak: HorizontalLayout {
                        alignment: center;
                        InstalledMark { installed: root.item.installed; }
                    }
                    if root.item.kind == PerfPackKind.fov: HorizontalLayout {
                        alignment: center;
                        FovMark { }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.item.title;
                        color: Theme.text;
                        font-size: Theme.text-lg;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.item.text != "": Text {
                        text: root.item.text;
                        color: Theme.text-muted;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                    if root.item.kind == PerfPackKind.fov: Text {
                        text: root.item.detail;
                        color: Theme.text-muted;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                    if root.item.warn != "": Text {
                        text: root.item.warn;
                        color: Theme.danger;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                }

                // Measured gains, right-aligned in one column.
                if root.item.avg != "": VerticalLayout {
                    width: 156px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        Text { text: root.item.avg; color: Theme.success; font-size: Theme.text-md; font-weight: 600; }
                        Text { text: "avg"; color: Theme.text-muted; font-size: Theme.text-sm; vertical-alignment: center; width: 46px; }
                    }
                    if root.item.low != "": HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        Text { text: root.item.low; color: Theme.success; font-size: Theme.text-md; font-weight: 600; }
                        Text { text: "1% low"; color: Theme.text-muted; font-size: Theme.text-sm; vertical-alignment: center; width: 46px; }
                    }
                }

                if root.item.kind == PerfPackKind.fov: Slider {
                    width: 300px;
                    label: "";
                    value: root.item.number;
                    minimum: root.item.minimum;
                    maximum: root.item.maximum;
                    step: root.item.step;
                    value-text: root.item.value-text;
                    changed(v) => { root.fov-changed(v); }
                }

                // The pak: Install / Update; once current, the lead check says
                // so and Reinstall shows on hover.
                // Always reserved, so the gains line up from card to card.
                if root.item.kind != PerfPackKind.fov: VerticalLayout {
                    width: 156px;
                    alignment: center;
                    if root.item.has-pak && !root.item.current: Button {
                        text: root.item.install-label;
                        disabled: root.item.installing;
                        clicked => { root.installed(); }
                    }
                    if root.item.has-pak && root.item.current: HorizontalLayout {
                        alignment: end;
                        height: Theme.control-h;
                        if ta.has-hover: TextButton {
                            text: "Reinstall";
                            clicked => { root.installed(); }
                        }
                    }
                }
            }

            // Versions as chips, indented under the name.
            if root.item.choices.length > 0: HorizontalLayout {
                padding-left: 40px + Theme.s2;
                spacing: Theme.s1;
                alignment: start;
                Text {
                    text: root.item.kind == PerfPackKind.hud ? "DAMAGE NUMBERS" : "VERSION";
                    color: Theme.text-muted;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
                for c[i] in root.item.choices: ChoiceChip {
                    label: c;
                    active: i == root.item.choice-index;
                    clicked => { root.picked(i); }
                }
            }

        }
    }
}


component SettingRow inherits Rectangle {
    in property <PerfRow> item;
    callback clicked;

    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { root.clicked(); }

    height: 48px;
    background: root.item.selected ? Theme.raised : (ta.has-hover ? Theme.hover : transparent);

    Rectangle {
        x: 0px;
        width: 2px;
        background: Theme.accent;
        visible: root.item.selected;
    }

    HorizontalLayout {
        padding-left: Theme.s2;
        // Room for the list's scroll bar.
        padding-right: Theme.s3;
        spacing: Theme.s2;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.text-md;
                overflow: elide;
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }
        Text {
            max-width: 160px;
            text: root.item.pending != ""
                ? (root.item.current != "" ? root.item.current : "unset") + "  →  " + root.item.pending
                : root.item.current;
            color: root.item.pending != "" ? Theme.accent : Theme.text-muted;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Free-text value entry; Enter or Set reports it.
component ValueField inherits Rectangle {
    in property <string> value;
    in property <string> identity;
    callback submitted(string);

    // A new selection (or a value set elsewhere) replaces what was typed.
    property <string> source: root.identity + "\n" + root.value;
    changed source => { input.text = root.value; }

    HorizontalLayout {
        spacing: Theme.s1;
        Rectangle {
            horizontal-stretch: 1;
            height: Theme.control-h;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: Theme.bg;
            input := TextInput {
                x: Theme.s1;
                width: parent.width - 2 * Theme.s1;
                height: parent.height;
                text: root.value;
                single-line: true;
                color: Theme.text;
                font-size: Theme.text-md;
                vertical-alignment: center;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: "Value";
                accepted => { root.submitted(self.text); }
            }
        }
        Button {
            text: "Set";
            clicked => { root.submitted(input.text); }
        }
    }
}

component EditorPanel inherits Rectangle {
    in property <PerfEditor> e;

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.raised;

    if !root.e.open: Text {
        x: Theme.s2;
        width: parent.width - 2 * Theme.s2;
        height: parent.height;
        text: "Select a setting to see what it does and change it.";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        vertical-alignment: center;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.e.open: VerticalLayout {
        padding: Theme.s2;
        spacing: Theme.s1;
        alignment: start;

        Text {
            text: root.e.name;
            color: Theme.text;
            font-size: Theme.text-lg;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.e.meta;
            color: Theme.text-muted;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
        Text {
            text: root.e.help;
            visible: root.e.help != "";
            color: Theme.text;
            font-size: Theme.text-md;
            wrap: word-wrap;
        }
        Text {
            text: root.e.limits;
            visible: root.e.limits != "";
            color: Theme.text-muted;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
        Text {
            text: root.e.current;
            color: Theme.text-muted;
            font-size: Theme.text-sm;
        }

        Rectangle { height: Theme.s1; }

        if root.e.control == PerfControl.toggle: HorizontalLayout {
            spacing: Theme.s2;
            Switch {
                label: root.e.name;
                checked: root.e.checked;
                toggled => { PerfState.toggle(); }
            }
            Text {
                text: root.e.checked ? "On" : "Off";
                color: Theme.text;
                font-size: Theme.text-md;
                vertical-alignment: center;
            }
        }

        if root.e.control == PerfControl.slider: Slider {
            label: "Value";
            value: root.e.number;
            minimum: root.e.minimum;
            maximum: root.e.maximum;
            step: root.e.step;
            value-text: root.e.value;
            changed(v) => { PerfState.set-number(v); }
        }

        if root.e.control == PerfControl.choice: Dropdown {
            label: root.e.name;
            options: root.e.options;
            current-index: root.e.option-index;
            selected(i) => { PerfState.pick-option(i); }
        }

        if root.e.control != PerfControl.toggle && root.e.control != PerfControl.choice && root.e.control != PerfControl.locked: ValueField {
            value: root.e.value;
            identity: root.e.name;
            submitted(t) => { PerfState.set-text(t); }
        }

        Text {
            text: root.e.note;
            visible: root.e.note != "";
            color: Theme.danger;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.s1;
            alignment: start;
            TextButton {
                text: "Revert";
                disabled: !root.e.has-pending;
                clicked => { PerfState.revert(); }
            }
            TextButton {
                text: "Comment out";
                disabled: !root.e.is-set || root.e.control == PerfControl.locked;
                clicked => { PerfState.comment-out(); }
            }
        }
    }
}

component ChangeRow inherits Rectangle {
    in property <PerfChange> change;
    callback remove;

    height: 40px;

    HorizontalLayout {
        padding-left: Theme.s2;
        // Room for the list's scroll bar.
        padding-right: Theme.s3;
        spacing: Theme.s1;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.change.name;
                color: Theme.text;
                font-size: Theme.text-sm;
                overflow: elide;
            }
            Text {
                text: root.change.before + "  →  " + root.change.after;
                color: Theme.text-muted;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }
        TextButton {
            y: (parent.height - self.height) / 2;
            text: "Undo";
            accessible-label: "Undo " + root.change.name;
            clicked => { root.remove(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}


export component PerformancePage inherits Rectangle {
    background: Theme.bg;

    // The pending-changes list above the footer is open.
    property <bool> review-open: false;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding: Theme.s3;
            padding-bottom: 0px;
            spacing: Theme.s2;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Performance";
                    color: Theme.text;
                    font-size: Theme.text-xl;
                    font-weight: 600;
                }
                Text {
                    text: PerfState.status;
                    color: Theme.text-muted;
                    font-size: Theme.text-sm;
                    overflow: elide;
                }
            }

            // Presets on one line; the picked one's source below it.
            if PerfState.load-state == LoadState.ready: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: Theme.s1;
                    alignment: start;
                    Text {
                        text: "PRESET";
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        width: 64px;
                    }
                    for tier[i] in PerfState.tiers: PresetChip {
                        label: tier.label;
                        available: tier.available;
                        active: PerfState.active-tier == i;
                        clicked => { PerfState.pick-tier(i); }
                    }
                    PresetChip {
                        label: "CompLock";
                        tip: PerfState.complock.note;
                        available: PerfState.complock.available;
                        active: PerfState.complock-staged;
                        clicked => { PerfState.stage-complock(); }
                    }
                }
                Text {
                    x: 64px + Theme.s1;
                    text: PerfState.complock-staged ? PerfState.complock.subtitle
                        : (PerfState.active-tier >= 0 ? PerfState.tiers[PerfState.active-tier].name
                        : "A preset stages a whole config. Nothing is written until you apply.");
                    color: Theme.text-muted;
                    font-size: Theme.text-sm;
                    overflow: elide;
                }
            }

            if PerfState.load-state == LoadState.ready: Rectangle {
                height: 36px;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    spacing: Theme.s3;
                    alignment: start;
                    SectionTab {
                        label: "CompLock options";
                        active: PerfState.section == 0;
                        clicked => { PerfState.section = 0; }
                    }
                    SectionTab {
                        label: "All settings";
                        active: PerfState.section == 1;
                        clicked => { PerfState.section = 1; }
                    }
                }
            }
        }

        if PerfState.load-state == LoadState.loading: CenteredMessage {
            vertical-stretch: 1;
            title: "Loading the performance catalog";
            detail: "Presets and setting details come from the Deadlock Mod Manager API.";
        }

        if PerfState.load-state == LoadState.failed: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.s2;
            CenteredMessage {
                title: "Couldn't load the performance catalog";
                detail: PerfState.error-text;
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: "Retry";
                    primary: true;
                    clicked => { PerfState.retry(); }
                }
            }
        }

        // The page's one scroll: group headings and one card per option.
        if PerfState.load-state == LoadState.ready && PerfState.section == 0: complock-options := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                padding-top: Theme.s2;
                padding-bottom: Theme.s3;
                spacing: 10px;
                alignment: start;
                for pack[i] in PerfState.pack-rows: VerticalLayout {
                    padding-top: pack.kind == PerfPackKind.heading && i > 0 ? Theme.s2 : 0px;
                    if pack.kind == PerfPackKind.heading: SectionHeader {
                        title: pack.title.to-uppercase();
                        blurb: pack.detail;
                    }
                    if pack.kind != PerfPackKind.heading: PackCard {
                        item: pack;
                        toggled => { PerfState.toggle-pack(pack.id); }
                        picked(c) => { PerfState.pick-pack-choice(pack.id, c); }
                        installed => { PerfState.install-pack(pack.id); }
                        fov-changed(v) => { PerfState.set-fov(v); }
                    }
                }
            }
        }

        // Every setting: the searchable list and the selected one's editor.
        if PerfState.load-state == LoadState.ready && PerfState.section == 1: HorizontalLayout {
            vertical-stretch: 1;
            padding: Theme.s3;
            padding-top: Theme.s2;
            spacing: Theme.s3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.s1;
                SearchField {
                    placeholder: "Search settings";
                    edited(t) => { PerfState.search(t); }
                }
                Text {
                    text: PerfState.list-note;
                    color: Theme.text-muted;
                    font-size: Theme.text-sm;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    ListView {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        for row[i] in PerfState.rows: SettingRow {
                            item: row;
                            clicked => { PerfState.select(i); }
                        }
                    }
                }
            }
            EditorPanel {
                width: 340px;
                e: PerfState.editor;
            }
        }

        // The staged changes, opened from the footer.
        if PerfState.load-state == LoadState.ready && root.review-open && PerfState.changes.length > 0: Rectangle {
            height: min(PerfState.changes.length * 40px + 2px, 200px);
            background: Theme.bg-sunken;
            Rectangle { y: 0px; height: 1px; background: Theme.border; }
            ListView {
                x: Theme.s2;
                y: 1px;
                width: parent.width - 2 * Theme.s2;
                height: parent.height - 1px;
                for change[i] in PerfState.changes: ChangeRow {
                    change: change;
                    remove => { PerfState.remove-change(i); }
                }
            }
        }

        // Sticky footer: what is staged, the outcome, and Apply.
        if PerfState.load-state == LoadState.ready: footer := Rectangle {
            height: 76px;
            background: Theme.sidebar;
            Rectangle { y: 0px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s2;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: Theme.s2;
                        alignment: start;
                        Text {
                            text: PerfState.changes.length > 0
                                ? (PerfState.changes.length == 1 ? "1 pending change" : PerfState.changes.length + " pending changes")
                                : (PerfState.result-title != "" ? PerfState.result-title : "No pending changes");
                            color: PerfState.result-error ? Theme.danger
                                : (PerfState.changes.length > 0 ? Theme.text
                                : (PerfState.result-title != "" ? Theme.success : Theme.text-muted));
                            font-size: Theme.text-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if PerfState.changes.length > 0: TextButton {
                            text: root.review-open ? "Hide" : "Review";
                            clicked => { root.review-open = !root.review-open; }
                        }
                        if PerfState.changes.length > 0: TextButton {
                            text: "Discard all";
                            disabled: PerfState.busy;
                            clicked => { PerfState.discard(); }
                        }
                        if PerfState.changes.length == 0 && PerfState.result-title != "": TextButton {
                            text: "Dismiss";
                            clicked => { PerfState.dismiss-result(); }
                        }
                    }
                    Text {
                        text: PerfState.game-running ? "Deadlock is running. Close the game to apply."
                            : (PerfState.result-title != "" ? PerfState.result-detail
                            : "Nothing is written to gameinfo.gi until you apply.");
                        color: PerfState.game-running ? Theme.accent : Theme.text-muted;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        width: 240px;
                        height: 44px;
                        text: PerfState.busy ? "Applying" : (PerfState.changes.length == 0 ? "Up to date" : PerfState.apply-label);
                        primary: true;
                        disabled: PerfState.changes.length == 0 || PerfState.busy;
                        clicked => { PerfState.apply(); }
                    }
                }
            }
        }
    }
}
