// Installed: mods found in the addons folder, with enable toggle and uninstall.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextButton, Switch, ProgressBar, SearchField, Tooltip } from "widgets.slint";
import { LoadState, CenteredMessage } from "browse.slint";

export enum SourceKind { none, complock, registry, manual }

export struct InstalledRow {
    id: string,
    name: string,
    detail: string,
    // Colour-coded tag indicating where the mod came from.
    source-label: string,
    source-kind: SourceKind,
    // Subtle label for VPKs Shiv did not install; empty for managed mods.
    tag: string,
    // The catalog's author; "" when unknown.
    author: string,
    // The one line under the name: the description's first line, else the
    // tag, else the detail.
    blurb: string,
    // The card's tooltip: the full description and the file details.
    about: string,
    thumb: image,
    has-thumb: bool,
    enabled: bool,
    managed: bool,
    // The catalog has a newer version than the installed one.
    update: bool,
    // Button label for an available update ("Update to 2026-11-23" or "Update").
    update-label: string,
    // An install or update of this mod is downloading or installing.
    transferring: bool,
    // 0..1, negative when the size is unknown.
    progress: float,
    transfer-text: string,
    // 1-based place in the load order (1 loads first and wins conflicts);
    // 0 when the mod cannot be moved.
    position: int,
    can-up: bool,
    can-down: bool,
    // Installed from a local file or adopted: no catalog page or updates.
    local: bool,
    // How the files compare with the source's release ("" when they match
    // or nothing is known): modified, a newer release, retired upstream.
    drift: string,
    // The drift as a short pill ("Update available"); "" for none. `drift`
    // is its tooltip.
    pill: string,
    // Reset to release can reinstall the published files.
    can-reset: bool,
    // A reset left the previous files to put back.
    can-restore: bool,
}

export global InstalledState {
    in property <[InstalledRow]> rows;
    in property <LoadState> load-state: LoadState.loading;
    in property <string> error-text;
    in property <string> banner-text;
    in property <string> summary;
    // Deadlock is running: toggling and uninstalling are refused.
    in property <bool> game-running;
    // A re-read or an action is in flight on a worker thread.
    in property <bool> busy;
    // The repair package no longer matches the mods but still loads.
    in property <bool> repair-stale;
    // Row waiting for uninstall confirmation, "" when none.
    in-out property <string> confirm-id;
    // Number of installed mods with an available update.
    in property <int> update-count: 0;

    callback refresh();
    callback update-all();
    callback toggle(string);
    // Move a mod in the load order: 0 up, 1 down, 2 to the very first place.
    callback move(string, int);
    // Move a mod to a 1-based place in the load order.
    callback move-to(string, int);
    callback uninstall(string);
    // Download and install the mod's newer version.
    callback update(string);
    // Reinstall the published release over drifted files, keeping a backup.
    callback reset(string);
    // Put back the files the last reset replaced.
    callback restore(string);
    callback dismiss-banner();
    // Show the Repair screen.
    callback open-repair();
    // Replace a local or hand-added mod's files with a newer file.
    callback update-file(string);
    // Open the mod's catalog detail page (managed mods only).
    callback open-detail(string);
    // Rename or annotate a managed mod, or adopt one Shiv did not install.
    callback edit(string);
    // Install a .vpk or archive from disk, or a download link.
    callback install-file();
    // Export the installed library as an interchange bundle for another
    // mod manager.
    callback export-library();
    // Import an interchange bundle from another mod manager.
    callback import-library();
}

// A small triangle button for moving a mod up or down.

// A small triangle button for moving a mod up or down.
component ArrowButton inherits Rectangle {
    in property <bool> up;
    in property <bool> disabled;
    in property <string> label;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (!root.disabled) {
            root.clicked();
        }
    }

    width: 28px;
    height: 16px;
    border-radius: Theme.radius;
    opacity: root.disabled ? 0.3 : 1.0;
    background: ta.has-hover && !root.disabled ? Theme.hover : transparent;

    Path {
        width: 10px;
        height: 6px;
        viewbox-width: 12;
        viewbox-height: 7;
        commands: root.up ? "M 0 7 L 6 0 L 12 7 Z" : "M 0 0 L 12 0 L 6 7 Z";
        fill: ta.has-hover && !root.disabled ? Theme.text : Theme.text-muted;
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// Small caps status pill next to a mod's name; its full text on hover.
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> tip;

    height: 18px;
    width: label.preferred-width + 2 * 7px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.6);
    background: Theme.accent.with-alpha(0.12);

    label := Text {
        text: root.text.to-uppercase();
        color: Theme.accent;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        changed has-hover => {
            if (self.has-hover) {
                Tooltip.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                Tooltip.hide(root.tip);
            }
        }
    }
}

// Compact colour-coded tag showing which source a mod came from.
component SourceTag inherits Rectangle {
    in property <string> label;
    in property <SourceKind> kind;

    property <color> tone: root.kind == SourceKind.complock ? Theme.tag-complock
        : (root.kind == SourceKind.registry ? Theme.tag-registry : Theme.tag-manual);

    height: 18px;
    width: tag-text.preferred-width + 2 * 7px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.5);
    background: root.tone.with-alpha(0.14);

    tag-text := Text {
        text: root.label;
        color: root.tone;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One installed mod as its own card: load order, switch, thumbnail slot,
// name with author and status, one line about it, actions.
// Secondary actions show while the card is hovered.
component InstalledRowView inherits Rectangle {
    in property <InstalledRow> item;
    in property <bool> locked;
    // Files are being replaced: no toggling or uninstalling meanwhile.
    property <bool> frozen: root.locked || root.item.transferring;
    property <bool> confirming: InstalledState.confirm-id == root.item.id;
    property <bool> active: hover-area.has-hover || place.has-focus || root.confirming;

    height: 72px + Theme.s1;

    card := Rectangle {
        y: 0px;
        // Room on the right for the list's scroll bar.
        width: parent.width - 20px;
        height: 72px;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: root.active ? Theme.border-strong : Theme.border;
        background: Theme.raised;

        // The content sits inside the hover area, so pointing at a control
        // keeps the card hovered and its actions visible.
        hover-area := TouchArea {
            mouse-cursor: root.item.managed && !root.item.local ? pointer : default;
            clicked => {
                if (root.item.managed && !root.item.local) {
                    InstalledState.open-detail(root.item.id);
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: Theme.s2;
                spacing: 12px;

                // Load order: the place, with arrows while hovered. Type a
                // place and press Enter to jump there.
                VerticalLayout {
                    width: 28px;
                    alignment: center;
                    if root.item.position > 0: ArrowButton {
                        up: true;
                        opacity: root.active ? (self.disabled ? 0.3 : 1.0) : 0.0;
                        label: "Load " + root.item.name + " earlier";
                        disabled: root.frozen || !root.item.can-up;
                        clicked => { InstalledState.move(root.item.id, 0); }
                    }
                    Rectangle {
                        height: 22px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: place.has-focus ? Theme.accent : (place-hover.has-hover ? Theme.border-strong : transparent);
                        visible: root.item.position > 0;
                        place-hover := TouchArea {
                            mouse-cursor: text;
                            place := TextInput {
                                text: "" + root.item.position;
                                input-type: number;
                                font-size: Theme.text-sm;
                                font-weight: 600;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                enabled: !root.frozen;
                                accessible-label: "Load order place of " + root.item.name;
                                accepted => {
                                    InstalledState.move-to(root.item.id, Math.round(self.text.to-float()));
                                    self.clear-focus();
                                }
                                // A moved mod gets a new place; typing breaks the text
                                // binding, so set it again.
                                property <int> shown: root.item.position;
                                changed shown => { self.text = "" + self.shown; }
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        self.text = "" + root.item.position;
                                    }
                                }
                            }
                        }
                    }
                    if root.item.position > 0: ArrowButton {
                        up: false;
                        opacity: root.active ? (self.disabled ? 0.3 : 1.0) : 0.0;
                        label: "Load " + root.item.name + " later";
                        disabled: root.frozen || !root.item.can-down;
                        clicked => { InstalledState.move(root.item.id, 1); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Switch {
                        label: "Enable " + root.item.name;
                        checked: root.item.enabled;
                        disabled: root.frozen;
                        toggled => { InstalledState.toggle(root.item.id); }
                    }
                }

                // The thumbnail slot is kept on every card, so names line up;
                // without an image it holds only a faint package mark.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 54px;
                        border-radius: Theme.radius;
                        clip: true;
                        if root.item.has-thumb: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.item.thumb;
                            image-fit: cover;
                        }
                        if !root.item.has-thumb: Path {
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            commands: "M 9 1.5 L 16 5 L 16 13 L 9 16.5 L 2 13 L 2 5 Z M 2 5 L 9 8.5 L 16 5 M 9 8.5 L 9 16.5";
                            stroke: Theme.text-faint;
                            stroke-width: 1.2px;
                            fill: transparent;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: Theme.s1;
                        alignment: start;
                        Text {
                            text: root.item.name;
                            color: root.item.enabled ? Theme.text : Theme.text-muted;
                            font-size: Theme.text-lg;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.item.source-label != "": VerticalLayout {
                            alignment: center;
                            SourceTag {
                                label: root.item.source-label;
                                kind: root.item.source-kind;
                            }
                        }
                        if root.item.author != "": Text {
                            text: "by " + root.item.author;
                            color: Theme.text-muted;
                            font-size: Theme.text-sm;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.item.detail != "" && root.item.blurb != root.item.detail: Text {
                            text: (root.item.author != "" ? "\u{b7} " : "") + root.item.detail;
                            color: Theme.text-faint;
                            font-size: Theme.text-sm;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.item.pill != "": VerticalLayout {
                            alignment: center;
                            Pill {
                                text: root.item.pill;
                                tip: root.item.drift;
                            }
                        }
                    }
                    blurb := Text {
                        text: root.item.blurb;
                        color: Theme.text-muted;
                        font-size: Theme.text-sm;
                        overflow: elide;
                        TouchArea {
                            mouse-cursor: hover-area.mouse-cursor;
                            clicked => {
                                if (root.item.managed && !root.item.local) {
                                    InstalledState.open-detail(root.item.id);
                                }
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tooltip.show(root.item.about, blurb.absolute-position.x, blurb.absolute-position.y, blurb.height);
                                } else {
                                    Tooltip.hide(root.item.about);
                                }
                            }
                        }
                    }
                }

                // Actions: an update, a running download and the drift fix
                // always; the rest fade in while hovered. Uninstall asks first.
                if !root.confirming: HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s1;
                    if root.item.transferring: VerticalLayout {
                        width: 160px;
                        alignment: center;
                        spacing: 2px;
                        ProgressBar { progress: root.item.progress; }
                        Text {
                            text: root.item.transfer-text;
                            color: Theme.text-muted;
                            font-size: Theme.text-sm;
                            overflow: elide;
                        }
                    }
                    if root.item.can-restore: VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Restore previous";
                            // Shown while the card is hovered; always in place, so the
                            // card does not reflow under the pointer.
                            opacity: root.active ? (self.disabled ? 0.4 : 1.0) : 0.0;
                            disabled: root.frozen;
                            clicked => { InstalledState.restore(root.item.id); }
                        }
                    }
                    if root.item.local || !root.item.managed: VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Update from file";
                            opacity: root.active ? (self.disabled ? 0.4 : 1.0) : 0.0;
                            disabled: root.frozen;
                            clicked => { InstalledState.update-file(root.item.id); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: root.item.managed ? "Edit" : "Adopt";
                            opacity: root.active ? (self.disabled ? 0.4 : 1.0) : 0.0;
                            disabled: root.frozen;
                            clicked => { InstalledState.edit(root.item.id); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Uninstall";
                            opacity: root.active ? (self.disabled ? 0.4 : 1.0) : 0.0;
                            disabled: root.frozen;
                            clicked => { InstalledState.confirm-id = root.item.id; }
                        }
                    }
                    if root.item.can-reset: VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Reset to release";
                            disabled: root.frozen;
                            clicked => { InstalledState.reset(root.item.id); }
                        }
                    }
                    if root.item.update && !root.item.transferring: VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.item.update-label != "" ? root.item.update-label : "Update";
                            primary: true;
                            disabled: root.frozen;
                            clicked => { InstalledState.update(root.item.id); }
                        }
                    }
                }

                if root.confirming: HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s1;
                    Text {
                        text: "Delete this mod's files?";
                        color: Theme.text;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Keep";
                            clicked => { InstalledState.confirm-id = ""; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Delete";
                            danger: true;
                            disabled: root.frozen;
                            clicked => {
                                InstalledState.uninstall(root.item.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component InstalledPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding: Theme.s3;
        padding-bottom: 0px;
        spacing: Theme.s2;

        HorizontalLayout {
            spacing: Theme.s2;
            Text {
                text: "Installed";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                horizontal-stretch: 1;
            }
            Text {
                text: InstalledState.summary;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                vertical-alignment: center;
            }
            if InstalledState.update-count > 0: Button {
                text: "Update all (" + InstalledState.update-count + ")";
                primary: true;
                disabled: InstalledState.game-running || InstalledState.busy;
                clicked => { InstalledState.update-all(); }
            }
            Button {
                text: "Install a mod";
                disabled: InstalledState.game-running || InstalledState.busy;
                clicked => { InstalledState.install-file(); }
            }
            TextButton {
                text: "Export";
                disabled: InstalledState.game-running || InstalledState.busy;
                clicked => { InstalledState.export-library(); }
            }
            TextButton {
                text: "Import";
                disabled: InstalledState.game-running || InstalledState.busy;
                clicked => { InstalledState.import-library(); }
            }
            TextButton {
                text: "Check for updates";
                tip: "Rescan the addons folder and check loaded sources for newer versions.";
                clicked => { InstalledState.refresh(); }
            }
        }

        if InstalledState.game-running: Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.raised;
            HorizontalLayout {
                padding: Theme.s1;
                padding-left: Theme.s2;
                padding-right: Theme.s2;
                Text {
                    text: "Deadlock is running. Close it to enable, disable or uninstall mods, then press Check for updates.";
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if InstalledState.repair-stale: Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.raised;
            HorizontalLayout {
                padding-top: Theme.s1;
                padding-bottom: Theme.s1;
                padding-left: Theme.s2;
                padding-right: Theme.s1;
                spacing: Theme.s2;
                Text {
                    text: "Repair package out of date: your mods changed since the last repair, but the old repair package still loads and may patch files that changed or are gone. Re-apply or remove it on the Repair screen.";
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: "Open Repair";
                    clicked => { InstalledState.open-repair(); }
                }
            }
        }

        if InstalledState.banner-text != "": Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.raised;
            HorizontalLayout {
                padding-top: Theme.s1;
                padding-bottom: Theme.s1;
                padding-left: Theme.s2;
                padding-right: Theme.s1;
                spacing: Theme.s2;
                Text {
                    text: InstalledState.banner-text;
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: "Dismiss";
                    clicked => { InstalledState.dismiss-banner(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if InstalledState.load-state == LoadState.loading: CenteredMessage {
                title: "Loading installed mods";
            }

            if InstalledState.load-state == LoadState.failed: VerticalLayout {
                alignment: center;
                spacing: Theme.s2;
                CenteredMessage {
                    title: "Couldn't read installed mods";
                    detail: InstalledState.error-text;
                }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: "Retry";
                        primary: true;
                        clicked => { InstalledState.refresh(); }
                    }
                }
            }

            if InstalledState.load-state == LoadState.ready && InstalledState.rows.length == 0: CenteredMessage {
                title: "No mods installed";
                detail: "Mods you install from Browse, a file or a link appear here.";
            }

            ListView {
                visible: InstalledState.load-state == LoadState.ready && InstalledState.rows.length > 0;
                for row in InstalledState.rows: InstalledRowView {
                    item: row;
                    locked: InstalledState.game-running || InstalledState.busy;
                }
            }
        }
    }
}

export global ConflictState {
    in-out property <bool> open;
    in property <string> new-name;
    // Comma-separated names of the enabled mods the new one conflicts with.
    in property <string> old-names;
    in property <string> error-text;
    in property <bool> busy;
    // The dialog came from switching an installed mod on (nothing has changed
    // yet, so it can be cancelled); otherwise from an install that finished.
    in property <bool> enabling;

    callback keep-both();
    // Leave both on, with the new mod first in the load order.
    callback load-first();
    callback swap();
    callback cancel();

    // A pack install is waiting on paks that already use its slot numbers.
    in-out property <bool> slot-open;
    in property <string> slot-text;
    // True when every pak in this question looks like the pack. Replace is
    // offered only then. The primary button moves; it never deletes.
    in property <bool> slot-look-alike;
    callback slot-replace();
    callback slot-move();
    callback slot-cancel();
}

// Modal over the whole window: a new mod replaces the same hero's content as
// mods that are already enabled.
export component ConflictDialog inherits Rectangle {
    background: Theme.bg-sunken.with-alpha(0.75);

    // Swallow clicks on the scrim.
    TouchArea { }

    card := Rectangle {
        width: min(520px, root.width - 2 * Theme.s4);
        height: min(body.preferred-height, root.height - 2 * Theme.s4);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        // The card itself must not pass clicks to the scrim below.
        TouchArea { }

        body := VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;

            Text {
                text: "Another mod for the same hero";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.new-name + (ConflictState.enabling ? " would change" : " changes") + " the same thing as " + ConflictState.old-names + ", which is already enabled. Only one of them can win in game.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.enabling ? "Swapping switches the other mod off and this one on. Nothing is deleted." : "Swapping switches the old mod off. Its files stay, so you can turn it back on from Installed.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            if ConflictState.error-text != "": Text {
                text: ConflictState.error-text;
                color: Theme.danger;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.s1;
                alignment: end;
                if ConflictState.enabling: TextButton {
                    text: "Cancel";
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.cancel(); }
                }
                Button {
                    text: "Both, new first";
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.load-first(); }
                }
                Button {
                    text: "Enable both";
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.keep-both(); }
                }
                Button {
                    text: ConflictState.enabling ? "Swap" : "Swap for the new one";
                    primary: true;
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.swap(); }
                }
            }
        }
    }
}

// A pack install found other paks on the slots it needs. Look-alikes can
// be replaced or kept. Any other foreign pak can be moved or cancelled.
// The worker changes nothing until then.
export component SlotDialog inherits Rectangle {
    background: Theme.bg-sunken.with-alpha(0.75);
    TouchArea { }

    card := Rectangle {
        width: min(560px, root.width - 2 * Theme.s4);
        height: min(body.preferred-height, root.height - 2 * Theme.s4);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }

        body := VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;

            Text {
                text: "Other mods use the pack's slots";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.slot-text;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.slot-look-alike ? "Replace removes them. Keep both moves them to free numbers after the pack, so the pack wins where both change a file. Cancel changes nothing." : "They will be moved to free numbers after the pack, so they keep working. Where they change the same file as the pack, the pack wins. Cancel changes nothing.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.s1;
                alignment: end;
                TextButton {
                    text: "Cancel";
                    clicked => { ConflictState.slot-cancel(); }
                }
                if ConflictState.slot-look-alike: Button {
                    text: "Replace";
                    clicked => { ConflictState.slot-replace(); }
                }
                Button {
                    text: ConflictState.slot-look-alike ? "Keep both" : "Move";
                    primary: true;
                    clicked => { ConflictState.slot-move(); }
                }
            }
        }
    }
}

// One labelled single-line text field for the dialogs below.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    spacing: 4px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.text-sm;
    }
    input := SearchField {
        placeholder: root.placeholder;
    }
}

// Modal frame shared by the edit and install-from-file dialogs.
component DialogCard inherits Rectangle {
    in property <string> title;
    background: Theme.bg-sunken.with-alpha(0.75);

    // Swallow clicks on the scrim.
    TouchArea { }

    card := Rectangle {
        width: min(520px, root.width - 2 * Theme.s4);
        height: min(body.preferred-height, root.height - 2 * Theme.s4);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea { }

        body := VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                wrap: word-wrap;
            }
            @children
        }
    }
}

export global ModEditState {
    in-out property <bool> open;
    // Adopting a mod Shiv did not install (otherwise editing a managed one).
    in property <bool> adopt;
    // The files the mod consists of, for orientation.
    in property <string> files;
    in-out property <string> name;
    in-out property <string> notes;
    // The mod's VPKs carry pak numbers, so the pak it sits at can be changed.
    in property <bool> has-pak;
    // The pak number shown for editing, two digits ("05"); "5" and "pak05" parse too.
    in-out property <string> pak-text;
    in property <string> error-text;
    in property <bool> busy;

    callback save();
    callback cancel();
}

export component ModEditDialog inherits DialogCard {
    title: ModEditState.adopt ? "Adopt mod" : "Edit mod";
    Text {
        text: ModEditState.adopt
            ? "Shiv records " + ModEditState.files + " as a mod it manages. The files stay where they are and are not changed."
            : ModEditState.files;
        color: Theme.text-muted;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    Field {
        label: "Name";
        placeholder: "Display name";
        text <=> ModEditState.name;
    }
    if ModEditState.has-pak: Field {
        label: "Pak number";
        placeholder: "05";
        text <=> ModEditState.pak-text;
    }
    Field {
        label: "Notes";
        placeholder: "Optional, e.g. where the mod came from";
        text <=> ModEditState.notes;
    }
    if ModEditState.error-text != "": Text {
        text: ModEditState.error-text;
        color: Theme.danger;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        alignment: end;
        TextButton {
            text: "Cancel";
            disabled: ModEditState.busy;
            clicked => { ModEditState.cancel(); }
        }
        Button {
            text: ModEditState.adopt ? "Adopt" : "Save";
            primary: true;
            disabled: ModEditState.busy;
            clicked => { ModEditState.save(); }
        }
    }
}

export global LocalInstallState {
    in-out property <bool> open;
    in-out property <string> path;
    in-out property <string> name;
    in property <string> error-text;
    in property <bool> busy;

    // Pick the file with the system file dialog.
    callback browse();
    callback install();
    callback cancel();
}

export component LocalInstallDialog inherits DialogCard {
    title: "Install a mod";
    Text {
        text: "A .vpk file, a zip, rar or 7z archive with VPKs inside, or a download link. A pasted mod page from gamebanana.com or deadlocker.net, or a Deadlock Mod Manager or Grimoire install link, opens the mod's page instead. Shiv copies files into a free pak slot; a local file stays where it is.";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        Field {
            horizontal-stretch: 1;
            label: "File or link";
            placeholder: "/path/to/mod.vpk, a download or mod page link";
            text <=> LocalInstallState.path;
        }
        VerticalLayout {
            alignment: end;
            Button {
                text: "Browse";
                disabled: LocalInstallState.busy;
                clicked => { LocalInstallState.browse(); }
            }
        }
    }
    Field {
        label: "Name";
        placeholder: "Defaults to the file name";
        text <=> LocalInstallState.name;
    }
    if LocalInstallState.error-text != "": Text {
        text: LocalInstallState.error-text;
        color: Theme.danger;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        alignment: end;
        TextButton {
            text: "Cancel";
            disabled: LocalInstallState.busy;
            clicked => { LocalInstallState.cancel(); }
        }
        Button {
            text: LocalInstallState.busy ? "Installing" : "Install";
            primary: true;
            disabled: LocalInstallState.busy || InstalledState.busy || LocalInstallState.path == "";
            clicked => { LocalInstallState.install(); }
        }
    }
}

// A file is being dragged over the window.
export global DropState {
    in property <bool> hover;
}

export component DropOverlay inherits Rectangle {
    background: #000000b0;
    Rectangle {
        width: min(parent.width - 64px, 520px);
        height: 160px;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.raised;
        VerticalLayout {
            alignment: center;
            spacing: Theme.s1;
            padding: Theme.s2;
            Text {
                text: "Drop to install or update";
                color: Theme.text;
                font-size: Theme.text-lg;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "A .vpk, zip, rar or 7z, or several at once. A newer copy of an installed mod replaces it in place.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// Replacing a local or hand-added mod's files with a newer file (from the
// row's Update from file, or a dropped file that matches the mod).
export global UpdateFileState {
    in-out property <bool> open;
    in property <string> target-name;
    in-out property <string> path;
    // Why a dropped file was matched to the mod; "" from the row button.
    in property <string> reason-text;
    // Opened by a drop: offer installing it as a new mod instead.
    in property <bool> dropped;
    in property <string> error-text;
    in property <bool> busy;

    callback browse();
    callback replace();
    callback install-new();
    callback cancel();
}

export component UpdateFileDialog inherits DialogCard {
    title: "Replace " + UpdateFileState.target-name + "?";
    Text {
        text: (UpdateFileState.reason-text != "" ? UpdateFileState.reason-text + " " : "") + "The new file takes the same pak slot, so the load order, name and notes stay. The old file is kept in addons/.shiv/backup.";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        Field {
            horizontal-stretch: 1;
            label: "New file";
            placeholder: "/path/to/mod.vpk";
            text <=> UpdateFileState.path;
        }
        VerticalLayout {
            alignment: end;
            Button {
                text: "Browse";
                disabled: UpdateFileState.busy;
                clicked => { UpdateFileState.browse(); }
            }
        }
    }
    if UpdateFileState.error-text != "": Text {
        text: UpdateFileState.error-text;
        color: Theme.danger;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        alignment: end;
        TextButton {
            text: "Cancel";
            disabled: UpdateFileState.busy;
            clicked => { UpdateFileState.cancel(); }
        }
        if UpdateFileState.dropped: TextButton {
            text: "Install as new mod";
            disabled: UpdateFileState.busy;
            clicked => { UpdateFileState.install-new(); }
        }
        Button {
            text: UpdateFileState.busy ? "Replacing" : "Replace";
            primary: true;
            disabled: UpdateFileState.busy || InstalledState.busy || UpdateFileState.path == "";
            clicked => { UpdateFileState.replace(); }
        }
    }
}

// Confirmation before swapping a mod back to the backup stored in
// addons/.shiv/backup.
export global RestoreState {
    in-out property <bool> open;
    in property <string> mod-name;
    in property <string> current-version;
    in property <string> backup-version;
    in property <string> error-text;
    in property <bool> busy;

    callback confirm();
    callback cancel();
}

export component RestoreDialog inherits DialogCard {
    title: "Restore previous version of " + RestoreState.mod-name + "?";
    Text {
        text: "This swaps the current files (" + RestoreState.current-version + ") back to the backup in addons/.shiv/backup (" + RestoreState.backup-version + "). The current files stay saved as a backup so you can swap back later.";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    if RestoreState.error-text != "": Text {
        text: RestoreState.error-text;
        color: Theme.danger;
        font-size: Theme.text-md;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.s1;
        alignment: end;
        TextButton {
            text: "Cancel";
            disabled: RestoreState.busy;
            clicked => { RestoreState.cancel(); }
        }
        Button {
            text: RestoreState.busy ? "Restoring" : "Restore";
            primary: true;
            disabled: RestoreState.busy || InstalledState.busy;
            clicked => { RestoreState.confirm(); }
        }
    }
}
