<component type="desktop-application">
  <id>io.github.Siebe_Uy.shiv</id>
  <name>Shiv</name>
  <summary>Lean, fast mod manager for Deadlock</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.luxus">
    <name>luxus</name>
  </developer>
  <description>
    <p>Shiv is a small, native mod manager for Deadlock. It has no webview, so it stays light on memory and scrolls smoothly.</p>
    <p>Browse the Deadlock Mods catalog, install and order mods, manage profiles and launch the game through Steam.</p>
  </description>
  <launchable type="desktop-id">io.github.Siebe_Uy.shiv.desktop</launchable>
  <url type="homepage">https://github.com/luxus/shiv</url>
  <url type="bugtracker">https://github.com/luxus/shiv/issues</url>
  <url type="vcs-browser">https://github.com/luxus/shiv</url>
  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>shiv</binary>
  </provides>
